          "requirement_num": 788,
          "title": "团队群离开/回归团队后群资料人数、成员列表、时光相册及退出状态异常",
          "priority": "中",
          "category": "BUG修复",
          "progress_stage": "完善中",
          "progress_updated_at": "2026-10-16T10:56:05.874793+08:00"
        },
        "current_user": {
          "nickname": "黄捷",
          "user_id": "u-op5v1rlpx2chwv3x5s6lko6m7zbbec",
          "avatar": "https://icon.res.qzhuli.com/user_avatar/2026_09_23/kjkykgmbgs24z1eq7j4e.jpg"
        },
        "project_repositories": [
